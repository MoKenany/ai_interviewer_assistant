# ─────────────────────────────────────────────────────────────────
# AI Interview Platform — Local Environment Configuration
# Copy this file to .env and fill in real values before running.
# ─────────────────────────────────────────────────────────────────

# ── Database (local PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:admin123@localhost:5432/ai_interview_db

# ── Redis / Celery (local Redis service) ──────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ── AI API Keys ───────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ── Local Storage Root ────────────────────────────────────────────
# All uploads (resumes, videos, audio) are stored under this path.
STORAGE_ROOT=storage

# ── API Settings ──────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
